# --- Controller (Node.js) ---
# Port cho GET /sensors và POST /agent/decide
PORT=3000

# OpenRouter API key. ĐỂ TRỐNG -> controller chạy pure heuristic (offline demo, không cần LLM).
# Lấy key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model dùng tool-calling (free mặc định). Xem danh sách hỗ trợ tool:
# https://openrouter.ai/collections/tool-calling-models
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Fallback model trả phí nếu free model fail/rate-limit (để trống = chỉ heuristic)
OPENROUTER_MODEL_FALLBACK=

# --- USD connector (Python) ---
# URL của controller. Đổi thành URL VPS thật khi deploy.
CONTROLLER_URL=http://127.0.0.1:3000
